generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  clients   Client[]
  users     User[]
  createdAt DateTime @default(now())

  bookingAppUrl String?
  bookingAppKey String?
  plan          String  @default("basis") // "basis" | "pro" | "premium" — gates features across all clients of this org

  stripeCustomerId     String? @unique
  stripeSubscriptionId String? @unique
  subscriptionStatus   String? // Stripe subscription status, e.g. "active" | "past_due" | "canceled" — null if never subscribed
}

model Client {
  id             String        @id @default(cuid())
  slug           String        @unique
  config         String // JSON string (EventConfig)
  isDemo         Boolean       @default(false)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  blockedDates   BlockedDate[]
  inquiries      Inquiry[]
  events         Event[]
  rooms          Room[]
  invoices       Invoice[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model User {
  id                    String        @id @default(cuid())
  email                 String        @unique
  password              String // bcrypt hash
  organizationId        String?
  organization          Organization? @relation(fields: [organizationId], references: [id])
  createdAt             DateTime      @default(now())
  passwordChangedAt     DateTime?
  inviteToken           String?       @unique
  inviteTokenExpiresAt  DateTime?
}

model BlockedDate {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id])
  startDate DateTime
  endDate   DateTime
  label     String   @default("nicht verfügbar")
  createdAt DateTime @default(now())
}

model Inquiry {
  id               String    @id @default(cuid())
  clientId         String
  client           Client    @relation(fields: [clientId], references: [id])
  data             String // JSON string of InquiryFormData
  status           String    @default("neu")
  eventId          String?
  event            Event?    @relation(fields: [eventId], references: [id], onDelete: SetNull)
  roomId           String?
  room             Room?     @relation(fields: [roomId], references: [id], onDelete: SetNull)
  participantCount Int       @default(0)
  holdExpiresAt    DateTime? // capacity hold on an Event inquiry expires if left unanswered
  invoices         Invoice[]
  reminderSentAt   DateTime?
  cancelToken      String?   @unique
  cancelledAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Invoice {
  id         String    @id @default(cuid())
  clientId   String
  client     Client    @relation(fields: [clientId], references: [id])
  inquiryId  String
  inquiry    Inquiry   @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  type       String // "angebot" | "rechnung"
  number     String
  status     String    @default("offen") // "offen" | "bezahlt" | "storniert"
  lineItems  String // JSON: [{description, quantity, unitPrice}]
  taxRate    Float     @default(0.20)
  validUntil DateTime?
  dueDate    DateTime?
  notes      String    @default("")
  sentAt     DateTime?
  issuedAt   DateTime  @default(now())
  createdAt  DateTime  @default(now())

  // Invoice numbers are now scoped per client (Medium finding 7) — two
  // different clients can both legitimately have "ANB-2026-0001".
  @@unique([clientId, number])
}

model InvoiceCounter {
  id      String @id // e.g. "angebot-2026"
  counter Int    @default(0)
}

// One row per autologin token actually used, keyed by a hash of its HMAC
// signature — the unique constraint on tokenHash is the replay guard itself
// (Medium finding 9): a second use of the same token fails this insert.
// expiresAt mirrors the token's own short TTL, used only to let a cleanup
// pass drop rows that can no longer matter.
model UsedAutologinToken {
  tokenHash String   @id
  expiresAt DateTime
}

model Room {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name        String
  description String   @default("")
  image       String   @default("")
  capacity    Int?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  inquiries   Inquiry[]
  events      Event[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Event {
  id              String    @id @default(cuid())
  clientId        String
  client          Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name            String
  description     String    @default("")
  image           String    @default("")
  startDate       DateTime
  endDate         DateTime
  color           String    @default("")
  intern          Boolean   @default(false) // true = blocks the general calendar like a Sperrzeit
  pricePerPerson  Float     @default(0)
  minParticipants Int       @default(1)
  maxParticipants Int? // null = unbegrenzt
  bookedCount     Int       @default(0)
  showCapacity    Boolean   @default(true) // shows remaining spots for this event in the calendar/widget
  isActive        Boolean   @default(true)
  sortOrder       Int       @default(0)
  roomId          String?
  room            Room?     @relation(fields: [roomId], references: [id], onDelete: SetNull)
  inquiries       Inquiry[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// Fixed-window counters for lib/ratelimit.ts. Keys are hashed; rows older than
// a day are removed by /api/cron/cleanup-rate-limits.
model RateLimitEntry {
  key         String   @id
  count       Int      @default(1)
  windowStart DateTime @default(now())
}
